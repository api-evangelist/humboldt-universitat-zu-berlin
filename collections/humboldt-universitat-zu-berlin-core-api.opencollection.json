          "info": {
            "name": "List communities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://edoc.hu-berlin.de/server/api/core/communities",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ]
          },
          "docs": "Returns a paginated HAL collection of top-level and child communities."
        },
        {
          "info": {
            "name": "Get a community by UUID",
            "type": "http"
